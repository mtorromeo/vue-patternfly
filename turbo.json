{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "clean": {
      "cache": false,
      "dependsOn": [
        "^clean"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "clean",
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "inputs": [
        "src/**/*.vue",
        "src/**/*.ts",
        "tests/**/*.ts",
        "vitest.config.mts"
      ]
    },
    "lint": {
      "outputs": []
    }
  }
}
