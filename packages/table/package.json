{
  "name": "@vue-patternfly/table",
  "version": "6.0.0-alpha.2",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist",
    "build": "concurrently 'npm:build:*'",
    "build:vite": "vite build",
    "build:declarations": "vue-tsc --declaration --emitDeclarationOnly",
    "lint": "vue-tsc --noEmit",
    "watch": "concurrently 'npm:watch:*'",
    "watch:vite": "vite build --watch",
    "watch:tsc": "vue-tsc --declaration --emitDeclarationOnly --watch",
    "prepack": "pnpm clean && pnpm build"
  },
  "dependencies": {
    "@patternfly/react-styles": "^6.5.1",
    "@vue-patternfly/core": "workspace:^",
    "@vue-patternfly/icons": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.34",
    "@vueuse/core": "^14.3.0",
    "glob": "^13.0.0",
    "rimraf": "^6.0.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vue": "^3.5.34",
    "vue-tsc": "^3.3.2"
  },
  "peerDependencies": {
    "@vue-patternfly/core": "workspace:^",
    "@vueuse/core": "^13 || ^14"
  }
}
