{
  "name": "@vue-patternfly/table",
  "version": "6.0.0-alpha.3",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist",
    "build": "concurrently 'npm:build:*'",
    "build:vite": "vite build",
    "build:declarations": "vue-tsc --declaration --emitDeclarationOnly",
    "lint": "vue-tsc --noEmit && vue-tsc --noEmit -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "watch": "concurrently 'npm:watch:*'",
    "watch:vite": "vite build --watch",
    "watch:tsc": "vue-tsc --declaration --emitDeclarationOnly --watch",
    "prepack": "pnpm clean && pnpm build"
  },
  "dependencies": {
    "@vue-patternfly/icons": "workspace:^"
  },
  "devDependencies": {
    "@patternfly/react-styles": "^6.6.1",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue-patternfly/core": "workspace:^",
    "@vue/compiler-sfc": "^3.5.43",
    "@vueuse/core": "^15.0.0",
    "glob": "^13.0.6",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  },
  "peerDependencies": {
    "@vue-patternfly/core": "workspace:^",
    "@vueuse/core": "^13 || ^14 || ^15",
    "vue": "^3.5.0"
  }
}
