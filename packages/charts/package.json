{
  "name": "@vue-patternfly/charts",
  "version": "6.0.0-rc.2",
  "homepage": "https://mtorromeo.github.io/vue-patternfly/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtorromeo/vue-patternfly.git",
    "directory": "packages/charts"
  },
  "bugs": {
    "url": "https://github.com/mtorromeo/vue-patternfly/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist",
    "build": "concurrently 'npm:build:*'",
    "build:vite": "vite build",
    "build:declarations": "vue-tsc --declaration --emitDeclarationOnly",
    "lint": "vue-tsc --noEmit && vue-tsc --noEmit -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "watch": "concurrently 'npm:watch:*'",
    "watch:vite": "vite build --watch",
    "watch:tsc": "vue-tsc --declaration --emitDeclarationOnly --watch",
    "prepack": "pnpm clean && pnpm build"
  },
  "devDependencies": {
    "@patternfly/react-tokens": "^6.7.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue-patternfly/core": "workspace:^",
    "@vue/compiler-sfc": "^3.5.44",
    "@vueuse/core": "^15.0.0",
    "echarts": "^6.1.0",
    "glob": "^13.0.6",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "@vue-patternfly/core": "workspace:^",
    "@vueuse/core": "^13 || ^14 || ^15",
    "echarts": "^5.6.0 || ^6.0.0",
    "vue": "^3.5.0"
  }
}
