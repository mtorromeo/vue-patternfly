{
  "name": "@vue-patternfly/core",
  "version": "6.0.0-beta.9",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist",
    "build": "concurrently 'npm:build:*'",
    "build:vite": "vite build",
    "build:declarations": "vue-tsc --declaration --emitDeclarationOnly && node scripts/build-global.mjs",
    "lint": "vue-tsc --noEmit",
    "watch": "concurrently 'npm:watch:*'",
    "watch:vite": "vite build --watch",
    "watch:tsc": "vue-tsc --declaration --emitDeclarationOnly --watch",
    "watch:main.d.ts": "nodemon --watch dist/main.d.ts --watch 'dist/**/index.d.ts' --watch scripts/build-global.mjs -x \"node scripts/build-global.mjs\"",
    "prepack": "pnpm clean && pnpm build"
  },
  "dependencies": {
    "@floating-ui/core": "^1.7.5",
    "@floating-ui/dom": "^1.7.6",
    "@patternfly/patternfly": "^6.5.2",
    "@patternfly/react-styles": "^6.5.1",
    "@patternfly/react-tokens": "^6.5.1",
    "@vue-patternfly/icons": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.34",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "@vueuse/shared": "^14.3.0",
    "concurrently": "^9.1.2",
    "focus-trap": "^8.2.1",
    "fs-extra": "^11.3.5",
    "glob": "^13.0.6",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vue": "^3.5.34",
    "vue-component-type-helpers": "^3.3.2",
    "vue-router": "^5.0.7",
    "vue-tsc": "^3.3.2"
  },
  "peerDependencies": {
    "@vueuse/core": "^13 || ^14",
    "@vueuse/integrations": "^13 || ^14",
    "@vueuse/shared": "^13 || ^14",
    "focus-trap": "*"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
