{
  "name": "@vue-patternfly/core",
  "version": "6.0.0-beta.13",
  "homepage": "https://mtorromeo.github.io/vue-patternfly/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtorromeo/vue-patternfly.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mtorromeo/vue-patternfly/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist",
    "build": "concurrently 'npm:build:*'",
    "build:vite": "vite build",
    "build:declarations": "vue-tsc --declaration --emitDeclarationOnly && node scripts/build-global.mjs",
    "lint": "vue-tsc --noEmit && vue-tsc --noEmit -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "watch": "concurrently 'npm:watch:*'",
    "watch:vite": "vite build --watch",
    "watch:tsc": "vue-tsc --declaration --emitDeclarationOnly --watch",
    "watch:main.d.ts": "nodemon --watch dist/main.d.ts --watch 'dist/**/index.d.ts' --watch scripts/build-global.mjs -x \"node scripts/build-global.mjs\"",
    "prepack": "pnpm clean && pnpm build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@vue-patternfly/icons": "workspace:^"
  },
  "devDependencies": {
    "@patternfly/patternfly": "^6.6.1",
    "@patternfly/react-styles": "^6.6.1",
    "@patternfly/react-tokens": "^6.6.1",
    "@types/node": "^26.6.4",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/compiler-sfc": "^3.5.43",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@vueuse/shared": "^15.0.0",
    "concurrently": "^10.0.5",
    "focus-trap": "^8.2.3",
    "fs-extra": "^11.4.1",
    "glob": "^13.0.6",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vue": "^3.5.43",
    "vue-component-type-helpers": "^3.3.12",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.12"
  },
  "peerDependencies": {
    "@patternfly/patternfly": "^6",
    "@vueuse/core": "^13 || ^14 || ^15",
    "@vueuse/integrations": "^13 || ^14 || ^15",
    "@vueuse/shared": "^13 || ^14 || ^15",
    "focus-trap": "^7 || ^8",
    "vue": "^3.5.0",
    "vue-router": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  }
}
