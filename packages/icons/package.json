{
  "name": "@vue-patternfly/icons",
  "version": "6.0.0-alpha.1",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/js/index.js"
    },
    "./*": {
      "types": "./dist/esm/icons/*.d.ts",
      "import": "./dist/esm/icons/*.js",
      "require": "./dist/js/icons/*.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist src/icons src/index.js src/index.d.ts",
    "build": "concurrently 'npm:build:*'",
    "build:icons": "node scripts/build.mjs",
    "build:cjs": "tsc --build --verbose tsconfig.cjs.json",
    "build:esm": "tsc --build --verbose tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@patternfly/patternfly": "^6.6.1",
    "concurrently": "^10.0.5",
    "fs-extra": "^11.4.1",
    "glob": "^13.0.6",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
